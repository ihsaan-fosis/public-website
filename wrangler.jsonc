{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ihsaan-public-website",
  "account_id": "e0185fb378c844e8ec0ea5af347a244c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  // TEMP (2026-10-21): apex/www pointed back to Vercel old static site (ihsaan-official).
  // Domains detached so Cloudflare DNS can use Vercel A/CNAME records.
  // To restore this Worker on the domain: put the two custom_domain routes back, then
  // `cf workers triggers deploy --profile techihsaan` (deletes the Vercel DNS rows and
  // recreates AAAA 100::). See .pstack/domain-vercel-rollback.md.
  "routes": [],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into this Worker for caching; the name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ihsaan-public-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
