{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ihsaan-public-website",
  "account_id": "e0185fb378c844e8ec0ea5af347a244c",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  // Both custom domains are attached to this Worker. Cloudflare manages their DNS rows.
  // Apply route changes with `cf workers triggers deploy --profile techihsaan`.
  "routes": [
    { "pattern": "ihsaan.network", "custom_domain": true },
    { "pattern": "www.ihsaan.network", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // src/worker.ts answers byte-range requests for the hero video, which iOS Safari needs.
    "run_worker_first": ["/media/*.mp4"]
  },
  "services": [
    {
      // OpenNext calls back into this Worker for caching; the name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ihsaan-public-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Public, non-secret URL of the member platform's production Convex deployment.
  // The blog and /volunteer read published data from it. See docs/BLOG-PUBLISHING.md.
  "vars": {
    "CONVEX_URL": "https://glad-oyster-29.convex.cloud"
  },
  "observability": {
    "enabled": true
  }
}
