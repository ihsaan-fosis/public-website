# Public (client-exposed) variables
# Local dev: http://localhost:3000 (same default as member-platform)
# Production: https://ihsaan.network (set in hosting env)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only variables (add when integrating Clerk, Convex, analytics, etc.)
# CLERK_SECRET_KEY=
# CONVEX_DEPLOYMENT=

# Contact form (src/app/api/contact). Sending-only key for the ihsaan.network domain.
# Local: .dev.vars or .env.local. Production: `wrangler secret put RESEND_API_KEY`.
# RESEND_API_KEY=

# Cloudflare Turnstile for the contact form. Create a widget for ihsaan.network in the Cloudflare dashboard.
# Local dev can use Cloudflare's always-pass test pair: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is inlined at build time. Production secret: `wrangler secret put TURNSTILE_SECRET_KEY`.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
