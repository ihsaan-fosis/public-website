# Copy this file to .env.local for local development. Never commit .env.local.
# The site runs without provider credentials. Valid contact requests return 503
# until both RESEND_API_KEY and TURNSTILE_SECRET_KEY are configured.

# Public site origin for local development.
# Production builds always use https://ihsaan.network for canonical metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Resend sending key for the verified ihsaan.network domain.
# Leave empty unless a maintainer provides an approved development key.
# A valid key sends real email to the configured IHSAAN contact inbox.
RESEND_API_KEY=

# Server-only Turnstile secret. Leave unset for the default local setup.
# TURNSTILE_SECRET_KEY=

# Optional public Turnstile widget key. When unset, the app uses its production
# public site key. Do not set it to an empty string, which overrides the default.
# For localhost, put BOTH lines below in .env.development.local, not .env.local.
# These are Cloudflare's public test keys. Never use them in production builds.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# In development, .env.development.local overrides .env.local.
# The process environment overrides both files. Restart bun run dev after edits.
# Test challenge keys do not mock Resend or prevent real email delivery.

# Optional indexing guard retained for Vercel environments. Unset defaults to
# production indexing. Use preview to exclude a non-production build from search.
# VERCEL_ENV=preview

# HTTP integration checks require a running server and an explicit shell value:
# BASE_URL=http://localhost:3000 bun run test:integration
# BASE_URL is a test-runner setting, not an application variable.
# NODE_ENV is managed by Next.js. Do not set it here.

# Maintainers configure Worker runtime secrets through Wrangler, not this file.
# See docs/ENVIRONMENT.md for variable behavior and file order.
# See docs/MAINTAINERS.md for approved release steps and secret commands.
